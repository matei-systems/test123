# Supabase (Projekt-Einstellungen -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Nur serverseitig! Niemals ins Frontend. (Projekt -> API -> service_role)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Öffentliche Basis-URL (für QR-Links auf der Kundenkarte)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry (Fehler-Monitoring, P15) - optional, ohne diese Variablen bleibt
# Sentry inaktiv (sentry.*.config.ts). DSN in Sentry unter
# Settings -> Projects -> <Projekt> -> Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Nur nötig, wenn Sentry beim Build automatisch Source-Maps hochladen soll
# (Settings -> Auth Tokens). Ohne Token wird der Upload übersprungen.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
