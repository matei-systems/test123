# ============================================================================
# Pflicht - ohne diese startet die App nicht.
# ============================================================================

# Supabase (Projekt-Einstellungen -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Nur serverseitig! Niemals ins Frontend, niemals in ein Beispiel-/Vorlagen-
# File mit echtem Wert committen (siehe git-Historie dieses Projekts für ein
# Beispiel, warum das wichtig ist). Projekt -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Öffentliche Basis-URL (für QR-Links auf der Kundenkarte, E-Mail-Links,
# Sitemap/robots.txt, Stripe-Checkout-Rücksprung). In Produktion die echte
# Domain, z. B. https://app.matei-loyalty.at
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================================
# Stripe (P12, Abrechnung) - optional, ohne diese Variablen sind Tarife/
# Checkout sichtbar, aber inaktiv (lib/stripe.ts).
# ============================================================================
STRIPE_SECRET_KEY=
# Stripe Dashboard -> Developers -> Webhooks -> Signing secret, NACHDEM der
# Produktions-Webhook-Endpunkt (https://<domain>/api/stripe/webhook)
# angelegt wurde.
STRIPE_WEBHOOK_SECRET=
# Die 6 Preis-IDs aus Stripe (Produkte -> jeweiliger Preis -> API-ID,
# beginnt mit price_...). Monatlich/jährlich je Tarif, siehe lib/billing/plans.ts.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=

# ============================================================================
# E-Mail-Versand (Team-Einladungen, P7) - optional, ohne diese Variablen
# wird der Einladungslink stattdessen direkt angezeigt statt gemailt
# (lib/email.ts). Registrierung/Passwort-Reset laufen unabhängig davon immer
# über Supabase Auth selbst.
# ============================================================================
RESEND_API_KEY=
# Muss eine in Resend verifizierte Absenderadresse/-domain sein.
EMAIL_FROM=

# ============================================================================
# Apple Wallet (P9) - optional, ohne diese Variablen bleibt der "Zu Apple
# Wallet hinzufügen"-Button inaktiv (lib/apple-wallet.ts). Erfordert ein
# aktives Apple-Developer-Programm.
# ============================================================================
APPLE_TEAM_IDENTIFIER=
APPLE_PASS_TYPE_IDENTIFIER=
# PEM-Zertifikate als Ein-Zeilen-String mit \n statt echten Zeilenumbrüchen
# (z. B. via: awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' datei.pem).
APPLE_WWDR_CERTIFICATE=
APPLE_PASS_SIGNER_CERT=
APPLE_PASS_SIGNER_KEY=
APPLE_PASS_SIGNER_KEY_PASSPHRASE=
# Frei wählbares, langes Zufalls-Secret (z. B. openssl rand -hex 32) - wird
# NIE an Apple übermittelt, sondern nur intern zur Herleitung der Pass-
# Auth-Tokens verwendet.
APPLE_PASS_AUTH_SECRET=

# ============================================================================
# Google Wallet (P9) - optional, ohne diese Variablen bleibt der "Zu Google
# Wallet hinzufügen"-Button inaktiv (lib/google-wallet.ts). Erfordert einen
# von Google verifizierten Loyalty-Program-Issuer-Account.
# ============================================================================
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
# Wie bei Apple: Ein-Zeilen-String mit \n statt echten Zeilenumbrüchen.
GOOGLE_WALLET_PRIVATE_KEY=

# ============================================================================
# Sentry (Fehler-Monitoring, P15) - optional, ohne diese Variablen bleibt
# Sentry inaktiv (sentry.*.config.ts). DSN in Sentry unter
# Settings -> Projects -> <Projekt> -> Client Keys (DSN).
# ============================================================================
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Nur nötig, wenn Sentry beim Build automatisch Source-Maps hochladen soll
# (Settings -> Auth Tokens). Ohne Token wird der Upload übersprungen.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
